---
import ContactForm from '../../components/forms/ContactForm.astro';
import Container from '../../components/core/Container.astro';
import HeartFill from '../../components/svg/HeartFill.astro';
import StarFill from '../../components/svg/StarFill.astro';
import site from '../../config/site.js';
import SiteLayout from '../../layouts/SiteLayout.astro';

const seo = {
	title: 'Contact | Joshi Jam',
	description: 'Contact Page',
};
---

<SiteLayout seo={seo}>
	<Container>
		<section class="contact-hero__section">
			<div class="contact-hero__text-section">
				<h1>
					Contact Us
					<span class="hero-heading__icons hero-heading__icons--white" aria-hidden="true">
						<HeartFill class="hero-heading__icon hero-heading__icon--heart" />
						<StarFill class="hero-heading__icon hero-heading__icon--star" />
					</span>
				</h1>
				<p>
					Want us to organize your next event? Feel free to contact us with any questions or comments.
					Fill out the form or email us directly at
				</p>
				<a class="contact-hero__email" href={`mailto:${site.email}`}>{site.email}</a>
			</div>
			<div class="col-2__container">
				<ContactForm />
			</div>
		</section>
	</Container>
</SiteLayout>

<style>
	.contact-hero__section {
		margin: var(--section-margin) auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
		min-height: calc(90vh - var(--navbar-height));
		gap: 3rem;
	}
	.contact-hero__text-section {
		padding: 2rem;
		display: grid;
		align-content: center;
		gap: 1rem;
		background-color: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
		color: var(--theme-on-surface-1);
	}
	.contact-hero__text-section h1,
	.contact-hero__text-section p {
		margin: 0;
	}
	.contact-hero__email {
		width: fit-content;
	}
	.col-2__container {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	@media (max-width: 768px) {
		.contact-hero__section {
			grid-template-columns: 1fr;
		}
	}
</style>
