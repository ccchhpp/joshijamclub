---
import { getCollection } from 'astro:content';
import Container from '../../components/core/Container.astro';
import EventGrid from '../../components/events/EventGrid.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { newestFirst, toEventCard } from '../../utils/events';

const allEvents = (await getCollection('events')).sort(newestFirst);
const upcomingEvents = await Promise.all(allEvents.filter((event) => event.data.status === 'upcoming').map(toEventCard));
const pastEvents = await Promise.all(allEvents.filter((event) => event.data.status === 'past').map(toEventCard));

const seo = {
	title: 'Events | Joshi Jam',
	description: 'Upcoming and past events organized by Joshi Jam.',
};
---

<SiteLayout {seo}>
	<Container>
		<section class="event-list-section">
			<h1>Upcoming Jams</h1>
			{upcomingEvents.length > 0 ? (
				<EventGrid events={upcomingEvents} />
			) : (
				<p class="event-empty-state">No upcoming jams at this time. Check back soon!</p>
			)}
		</section>
		{pastEvents.length > 0 && (
			<section class="event-list-section">
				<h1>Past Jams</h1>
				<EventGrid events={pastEvents} />
			</section>
		)}
	</Container>
</SiteLayout>

<style>
	.event-list-section {
		margin: var(--section-margin) auto;
	}
</style>
