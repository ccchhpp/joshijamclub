---
import { getCollection } from 'astro:content';
import Button from '../components/buttons/Button.astro';
import Container from '../components/core/Container.astro';
import EventGrid from '../components/events/EventGrid.astro';
import CtaCardSection from '../components/sections/CtaCardSection.astro';
import HomeHero from '../components/sections/hero/HomeHero.astro';
import ThreeColumnTextSection from '../components/sections/ThreeColumnTextSection.astro';
import FlowerFill from '../components/svg/FlowerFill.astro';
import HeartFill from '../components/svg/HeartFill.astro';
import SparkleFill from '../components/svg/SparkleFill.astro';
import StarFill from '../components/svg/StarFill.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { newestFirst, toEventCard } from '../utils/events';

const upcomingEventEntries = (await getCollection('events'))
	.filter((event) => event.data.status === 'upcoming')
	.sort(newestFirst)
	.slice(0, 2);
const upcomingEvents = await Promise.all(upcomingEventEntries.map(toEventCard));
---


<SiteLayout>
	<HomeHero />

	<section class="about__section">
		<div class="about__bg-icons">
			<FlowerFill class="about__bg-icon about__bg-icon--flower" />
			<HeartFill class="about__bg-icon about__bg-icon--heart" />
			<SparkleFill class="about__bg-icon about__bg-icon--sparkle" />
			<StarFill class="about__bg-icon about__bg-icon--star" />
		</div>
		<h2>What We Do</h2>
		<ThreeColumnTextSection>
			<div slot="column-1-body">
				<HeartFill class="service-card__icon" aria-hidden="true" />
				<h3>Event Coordination</h3>
				<p>
				 Organization and logistics planning for running events big or small, including staffing, tabling, etc. Leave it to us!
				</p>
			</div>
			<div slot="column-2-body">
				<FlowerFill class="service-card__icon" aria-hidden="true" />
				<h3>Site Build Outs</h3>
				<p>
					Construction of booths for events, conventions, etc. Connecting you with services to make your presence known.
				</p>
			</div>
			<div slot="column-3-body">
				<StarFill class="service-card__icon" aria-hidden="true" />
				<h3>Graphic Design</h3>
				<p>
					Design services available to create your next logo or brand kit. Make your event stand out with something fresh!
				</p>
			</div>
		</ThreeColumnTextSection>
	</section>

	<Container>
		<section class="home-events">
			<div class="home-events__header">
				<div>
					<h2>Upcoming Jams</h2>
				</div>
				<a href="/events/">View all events →</a>
			</div>
			{upcomingEvents.length > 0 ? (
				<EventGrid events={upcomingEvents} />
			) : (
				<p class="event-empty-state">No upcoming jams at this time. Check back soon!</p>
			)}
		</section>
	</Container>

	<CtaCardSection>
		<h2>Want Us to Organize Your Next Event?</h2>
		<p>Contact us today and let’s make something happen!</p>
		<Button href="/contact">Get in Touch</Button>
	</CtaCardSection>
</SiteLayout>

<style>
	.about__section {
		margin: var(--section-margin) auto;
		text-align: center;
		background-color: var(--theme-surface-1);
		padding-top: 3rem;
		color: var(--theme-on-surface-1);
		position: relative;
		overflow: hidden;
	}
	.about__bg-icons {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 0;
	}
	.about__bg-icon {
		position: absolute;
		opacity: 0.13;
		filter: blur(0.5px) drop-shadow(0 2px 8px rgba(0,0,0,0.04));
		pointer-events: none;
		z-index: 0;
		transition: opacity 0.2s;
	}
	.about__bg-icon--flower {
		width: 120px; height: 120px;
		left: 4%; top: 12%;
		color: var(--theme-on-surface-1);
		transform: rotate(-18deg);
	}
	.about__bg-icon--heart {
		width: 160px; height: 160px;
		right: 2%; top: 8%;
		color: var(--theme-on-surface-1);
		transform: rotate(12deg);
	}
	.about__bg-icon--sparkle {
		width: 80px; height: 80px;
		left: 10%; bottom: 6%;
		color: var(--theme-on-surface-1);
		transform: rotate(-8deg);
	}
	.about__bg-icon--star {
		width: 100px; height: 100px;
		right: 8%; bottom: 10%;
		color: var(--theme-on-surface-1);
		transform: rotate(22deg);
	}
	.home-events {
		margin: clamp(3rem, 7vw, 6rem) auto;
	}
	.home-events .event-empty-state {
		margin-inline: auto;
	}
	.home-events__header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 2rem;
	}
	.home-events__header h2 {
		margin: 0;
	}
	.home-events__header > a {
		font-size: 0.9rem;
		font-weight: 800;
		text-decoration: none;
	}
	@media (max-width: 640px) {
		.home-events__header {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
