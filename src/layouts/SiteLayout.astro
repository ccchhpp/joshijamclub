---
import Button from '../components/buttons/Button.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import type { Props as SiteHeadProps } from '../components/SiteHead.astro';
import { navigationLinks } from '../config/navigation.js';
import { socialLinks } from '../config/social-links';
import site from '../config/site';
import SiteShell from './SiteShell.astro';


export interface Props {
	seo?: SiteHeadProps;
}

const { seo } = Astro.props as Props;
---

<SiteShell seo={seo}>
	<Header rightMenu navData={navigationLinks} slot="header">
    <Button slot="action-item" href="/contact">Contact Us</Button>
	</Header>
	<div id="page">
		<slot />
	</div>
	<Footer
		slot="footer"
		background="var(--theme-surface-1)"
		color="var(--theme-on-surface-1)"
    footerSocials={socialLinks}
		copyrightName={site.name}
	>
	</Footer>
</SiteShell>
