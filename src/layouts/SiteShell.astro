---
import SiteHead from '../components/SiteHead.astro';
import type { Props as SiteHeadProps } from '../components/SiteHead.astro';

export interface Props {
	seo?: SiteHeadProps;
}

const { seo } = Astro.props;
---

<html lang="en">
	<head>
		<SiteHead {...seo} />
	</head>
	<body>
    <slot name="announcement-bar" />
		<slot name="header" />
		<main id="content">
			<slot />
		</main>
		<slot name="footer" />
	</body>
</html>
