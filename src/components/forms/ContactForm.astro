---
import Button from '../buttons/Button.astro';
import FormInput from './form-fields/FormInput.astro';
import FormTextarea from './form-fields/FormTextarea.astro';
import site from '../../config/site.js';
---


<form
  id="contact-form"
  name="Contact Form"
  method="POST"
  action={`https://formsubmit.tailofleaves.dev/submit/${site.email}`}
  data-contact-email={site.email}
>
  <input type="hidden" name="FormName" value="Joshi Jam Contact Form" />
  <input id="form-started-at" type="hidden" name="FormStartedAt" value="" />
  <FormInput type="text" label="Name" name="Name" placeholder="Roy Mustang" autocomplete="name" required maxlength="80" />
  <FormInput type="email" label="Email" name="Email" placeholder="flame@alchemist.com" autocomplete="email" required maxlength="254" />
  <div class="contact-form__honeypot" aria-hidden="true">
    <label for="contact-website">Leave this field empty</label>
    <input id="contact-website" type="text" name="Website" tabindex="-1" autocomplete="off" />
  </div>
  <FormTextarea label="Message" name="Message" placeholder="Your message here..." required minlength="1" />
  <Button id="submit-btn" type="submit">Submit</Button>
  <div id="form-message" class="form-message" role="status" aria-live="polite"></div>
</form>

<script type="module">
  const form = document.getElementById('contact-form');
  const submitBtn = document.getElementById('submit-btn');
  const messageDiv = document.getElementById('form-message');
  const honeypotField = document.getElementById('contact-website');
  const startedAtField = document.getElementById('form-started-at');
  const contactEmail = form.dataset.contactEmail;

  const resetStartTime = () => {
    startedAtField.value = String(Date.now());
  };

  const showSuccess = () => {
    messageDiv.textContent = 'Thank you! Your message has been sent.';
    messageDiv.className = 'form-message success';
  };

  const showError = () => {
    const emailLink = document.createElement('a');
    emailLink.href = `mailto:${contactEmail}`;
    emailLink.textContent = contactEmail;
    messageDiv.replaceChildren(
      document.createTextNode('Sorry, there was an error sending your message. Please email us instead at '),
      emailLink,
      document.createTextNode('.')
    );
    messageDiv.className = 'form-message error';
  };

  resetStartTime();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    form.setAttribute('aria-busy', 'true');
    messageDiv.textContent = '';
    messageDiv.className = 'form-message';

    const elapsedTime = Date.now() - Number(startedAtField.value);
    if (honeypotField.value.trim() || elapsedTime < 2000) {
      showSuccess();
      form.reset();
      resetStartTime();
      submitBtn.disabled = false;
      form.removeAttribute('aria-busy');
      return;
    }

    const formData = new FormData(form);
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
      });
      if (response.ok) {
        showSuccess();
        form.reset();
        resetStartTime();
      } else {
        showError();
      }
    } catch (err) {
      showError();
    } finally {
      submitBtn.disabled = false;
      form.removeAttribute('aria-busy');
    }
  });
</script>

<style>
  form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .contact-form__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .form-message {
    min-height: 1.5em;
    margin-top: 0.5em;
    font-size: 1rem;
    text-align: center;
    transition: color 0.2s;
  }
  .form-message.success {
    color: #2e7d32;
  }
  .form-message.error {
    color: #c62828;
  }
</style>
